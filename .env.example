# TerraTriage environment template
# Copy to .env and fill values

TERRATRIAGE_ENVIRONMENT=development
TERRATRIAGE_DEBUG=true
TERRATRIAGE_LOG_LEVEL=INFO

# Database
TERRATRIAGE_DB_HOST=localhost
TERRATRIAGE_DB_PORT=5432
TERRATRIAGE_DB_DATABASE=terratriage
TERRATRIAGE_DB_USERNAME=postgres
TERRATRIAGE_DB_PASSWORD=postgres

# Redis
TERRATRIAGE_REDIS_HOST=localhost
TERRATRIAGE_REDIS_PORT=6379
TERRATRIAGE_REDIS_PASSWORD=
TERRATRIAGE_REDIS_DB=0

# Models — identifiers are swappable via env
TERRATRIAGE_MODEL_SEGMENTATION_MODEL_ID=nvidia/segformer-b0-finetuned-ade-512-512
TERRATRIAGE_MODEL_DETECTION_MODEL_ID=facebook/detr-resnet-50
TERRATRIAGE_MODEL_VQA_MODEL_ID=dandelin/vilt-b32-finetuned-vqa
TERRATRIAGE_MODEL_CAPTIONING_MODEL_ID=Salesforce/blip-image-captioning-base
TERRATRIAGE_MODEL_EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
TERRATRIAGE_MODEL_RERANKER_MODEL_ID=cross-encoder/ms-marco-MiniLM-L-6-v2
TERRATRIAGE_MODEL_LLM_MODEL_ID=microsoft/Phi-3-mini-4k-instruct
TERRATRIAGE_MODEL_DEVICE=cpu
TERRATRIAGE_MODEL_TORCH_DTYPE=float32

# Retrieval
TERRATRIAGE_RETRIEVAL_TOP_K=10
TERRATRIAGE_RETRIEVAL_RERANK_K=5
TERRATRIAGE_RETRIEVAL_SIMILARITY_THRESHOLD=0.7

# External APIs — leave blank to use fixture/offline mode
TERRATRIAGE_FEMA_API_KEY=
TERRATRIAGE_FEMA_USE_FIXTURES=true
TERRATRIAGE_NOAA_USE_FIXTURES=true

# Observability — set to langfuse to enable tracing to a Langfuse instance
TERRATRIAGE_OBS_PROVIDER=none
TERRATRIAGE_OBS_LANGFUSE_HOST=http://localhost:3000
TERRATRIAGE_OBS_LANGFUSE_PUBLIC_KEY=
TERRATRIAGE_OBS_LANGFUSE_SECRET_KEY=
TERRATRIAGE_OBS_LANGSMITH_API_KEY=
TERRATRIAGE_OBS_LANGSMITH_PROJECT=terratriage

# Storage
TERRATRIAGE_STORAGE_ARTIFACTS_ROOT=./artifacts
TERRATRIAGE_STORAGE_ASSESSMENTS_DIR=assessments

# API
TERRATRIAGE_API_HOST=0.0.0.0
TERRATRIAGE_API_PORT=8000
